{
  "kind": "collectionType",
  "collectionName": "insight_articles",
  "info": {
    "singularName": "insight-article",
    "pluralName": "insight-articles",
    "displayName": "Insight Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "string"
    },
    "excerpt": {
      "type": "text"
    },
    "content": {
      "type": "richtext"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "authorName": {
      "type": "string"
    },
    "publishedAtCustom": {
      "type": "datetime"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "trending": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "integer"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    }
  }
}
